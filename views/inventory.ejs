<%- include('partials/header', {title: 'Inventory Stock - CSCE 331 POS Web App'}) %>

<div class="card">
    <h2>POS Inventory Levels (Queried from PostgreSQL <code>inventory</code> Table)</h2>
    <p>This page dynamically monitors real-time inventory stock levels in our PostgreSQL database (<code>troupe_04_db</code>), highlighting low-stock items.</p>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Item / Supply Name</th>
                <th>Units In Stock</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% for (var i = 0; i < inventory.length; i++) { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><strong><%= inventory[i].item_name %></strong></td>
                    <td><code><%= inventory[i].amount %></code></td>
                    <td>
                        <% if (inventory[i].amount < 50) { %>
                            <span class="badge" style="background: #fee2e2; color: #991b1b;">Low Stock (&lt; 50)</span>
                        <% } else { %>
                            <span class="badge badge-success">In Stock</span>
                        <% } %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div style="margin-top: 1.5rem;">
        <a href="/" class="btn">&larr; Back to Home</a>
        <a href="/products" class="btn" style="background-color: #2c3e50; margin-left: 0.5rem;">View Menu Products &rarr;</a>
    </div>
</div>

<%- include('partials/footer') %>
